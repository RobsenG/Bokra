generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String?
  role              Role      @default(RENTER)
  phone             String?
  avatar            String?
  selfieUrl         String?
  selfieVerifiedAt  DateTime?
  isVerified        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  properties        Property[]
  bookings          Booking[]           @relation("RenterBookings")
  reviews           Review[]
  documents         Document[]
  favorites         Favorite[]
  withdrawals       WithdrawalRequest[]

  @@map("users")
}

model Property {
  id              String     @id @default(cuid())
  title           String
  description     String
  address         String
  city            String
  pricePerNight   Decimal
  bedrooms        Int
  bathrooms       Int
  maxGuests       Int
  amenities       String[]
  images          String[]
  isVerified      Boolean    @default(false)
  isAvailable     Boolean    @default(true)

  hostId          String
  host            User       @relation(fields: [hostId], references: [id])

  bookings        Booking[]
  reviews         Review[]
  favorites       Favorite[]
  documents       Document[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("properties")
}

model Booking {
  id            String        @id @default(cuid())
  checkIn       DateTime
  checkOut      DateTime
  totalPrice    Decimal
  status        BookingStatus @default(PENDING)

  renterId      String
  propertyId    String

  renter        User          @relation("RenterBookings", fields: [renterId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])
  payment       Payment?

  createdAt     DateTime      @default(now())

  @@map("bookings")
}

model Review {
  id         String   @id @default(cuid())
  rating     Int      @default(5)
  comment    String?
  createdAt  DateTime @default(now())

  renterId   String
  propertyId String

  renter     User     @relation(fields: [renterId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("reviews")
}

model Document {
  id         String         @id @default(cuid())
  type       DocumentType
  fileUrl    String
  status     DocumentStatus @default(PENDING)
  uploadedAt DateTime       @default(now())

  userId     String
  user       User           @relation(fields: [userId], references: [id])

  propertyId String?
  property   Property?      @relation(fields: [propertyId], references: [id])

  @@map("documents")
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  amount            Decimal
  currency          String        @default("ETB")
  status            PaymentStatus @default(PENDING)
  chapaReference    String?
  createdAt         DateTime      @default(now())

  @@map("payments")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favorites")
}

model WithdrawalRequest {
  id              String           @id @default(cuid())
  hostId          String
  host            User             @relation(fields: [hostId], references: [id])
  amount          Decimal
  accountType     String           // "bank" | "telebirr" | "chapa"
  accountNumber   String
  accountName     String
  status          WithdrawalStatus @default(PENDING)
  chapaReference  String?
  note            String?
  createdAt       DateTime         @default(now())
  processedAt     DateTime?

  @@map("withdrawal_requests")
}

model AdminNotification {
  id               String   @id @default(cuid())
  type             String   // "DUPLICATE_PROPERTY" | "NEW_LISTING" | "DOCUMENT_UPLOADED"
  message          String
  isRead           Boolean  @default(false)
  propertyId       String?
  reportedByUserId String?
  createdAt        DateTime @default(now())

  @@map("admin_notifications")
}

enum Role {
  RENTER
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DocumentType {
  ID_CARD
  OWNERSHIP_PROOF
  HOUSE_REGISTRATION
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}